# Copiá este archivo como .env para cambiar la configuración de Docker Compose.
# Puerto del host donde se publica SUMMA (el contenedor escucha en 8080).
SUMMA_PORT=8081
# Interfaz del host. 127.0.0.1 = solo local (recomendado detrás de un reverse proxy).
# Usá 0.0.0.0 únicamente si sabés que querés exponerlo en la red.
SUMMA_BIND_HOST=127.0.0.1
